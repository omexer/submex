<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Submex admin preview</title>
<link rel="stylesheet" href="css/buttons.min.css">
<link rel="stylesheet" href="css/common.min.css">
<link rel="stylesheet" href="css/forms.min.css">
<link rel="stylesheet" href="css/admin.css">
<link rel="stylesheet" href="preview.css">
<style>html,body{margin:0}body{background:#f6f7fb;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}#wpcontent{margin:0;padding:0}.submex-shell__bar{top:0}</style>
</head>
<body class="wp-admin submex-admin">
<div id="wpwrap"><div id="wpcontent"><div id="wpbody-content">
<div class="submex-shell">
	<header class="submex-shell__bar"><div class="submex-shell__inner">
		<nav class="submex-crumbs"><a class="submex-crumbs__home" href="#dashboard">{{MARK}}<span>Submex</span></a><span class="submex-crumbs__sep">/</span><span class="submex-crumbs__current">Home</span></nav>
		<div class="submex-shell__meta"><a href="#">Help</a><a href="#">Settings</a></div>
	</div></header>
	<div class="wrap submex-shell__body">
		<div class="submex-head"><div class="submex-head__text"><h1 class="submex-head__title"></h1><p class="submex-head__subtitle"></p></div></div>
		<div id="screen" class="submex-ui"></div>
	</div>
	<footer class="submex-shell__foot">Submex {{VERSION}} · <a href="#">Help and system report</a></footer>
</div>
</div></div></div>
<script src="preview.js"></script>
</body>
</html>
